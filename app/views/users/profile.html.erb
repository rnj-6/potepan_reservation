<div class="btn-menu-mypage">
   <%= link_to "◂ 戻る", users_path, class: "back-btn" %>
   <%= link_to "編集", users_profile_edit_path, class: "edit-btn" %>
</div>

<div class="card-design-mypage">
   <h2 class="card-design-title">プロフィール</h2>

   <div class="profile-content">
      <% if @user.image.attached? %>
         <%= image_tag @user.image.variant(resize_to_fill: [100, 100]) %>
      <% else %>
         <%= image_tag "https://rails-02-sample.herokuapp.com/assets/common/default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png", width: 100, height: 100 %>
      <% end %>
   </div>

   <div class="profile-content">
      <p class="profile-content-label">ユーザー名</p>
      <%= @user.name %>
   </div>

   <div class="profile-content">
      <p class="profile-content-label">自己紹介</p>
      <%= @user.introduction %>
   </div>
</div>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            