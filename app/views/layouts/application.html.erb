<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Potepan Reservation App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="header">

      <div>
        <%= link_to "POTEPAN TRAVEL", root_path, class: "header-logo" %>
      </div>

      <div class="header-container">
        <% if user_signed_in? %>

          <div class="header-nav" data-controller="dropdown" data-action="click@window->dropdown#close">
            <div class="header-nav-user" data-action="click->dropdown#toggle">
              <div class="header-nav-icon">
                <% if current_user.image.attached? %>
                  <%= image_tag current_user.image.variant(resize_to_fill: [50, 50]) %>
                <% else %>
                  <%= image_tag "https://rails-02-sample.herokuapp.com/assets/common/default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png", width: 50, height: 50 %>
                <% end %>
              </div>

              <p><%= current_user.name %> ▾</p>
            </div>

              <ul data-dropdown-target="menu" class="dropdown-menu">
                <li>
                  <%= link_to "マイページ", users_path %>
                </li>

                <li>
                  <%= link_to "施設の新規作成", new_room_path %>
                </li>

                <li>
                  <%= link_to "作成した施設一覧", rooms_path %>
                </li>

                <li>
                  <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %>
                </li>
              </ul>
          </div>

        <% else %>
          <div class="header-btn">
            <li>
              <%= link_to "新規登録", new_user_registration_path %>
            </li>
            <li>
              <%= link_to "ログイン", new_user_session_path %>
            </li>
          </div>
        <% end %>
      </div>
    </header>

    <%= yield %>
  </body>
</html>
