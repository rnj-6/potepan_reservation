<div>
    <%= form_with model: @room do |f| %>

        <div class="room-firld">
            <%= f.label :name, "施設名" %>
            <%= f.text_field :name, placeholder: "施設名を入力" %>
        </div>

        <div class="room-firld">
            <%= f.label :address, "住所" %>
            <%= f.text_field :address, placeholder: "住所を入力" %>
        </div>

        <div class="room-firld">
            <%= f.label :description, "施設詳細" %>
            <%= f.text_area :description, placeholder: "施設詳細を入力" %>
        </div>

        <div class="room-firld">
            <%= f.label :price, "料金" %>
            <%= f.number_field :price, placeholder: "一日あたりの料金を入力" %>
        </div>

        <div class="room-image-firld">
            <%= f.label :image, "写真", class: "room-image-label" %>
            <div class="image-upload-wrapper">
                <%= f.file_field :image, id: "image-upload", hidden: true %>
                <label for="image-upload" class="room-image-firld-label">画像アップロード</label>
            </div>
        </div>

        <div class="btn-menu">
            <%= f.submit "保存", class: "update-btn" %>
            <%= link_to "キャンセル", request.referer || root_path, class: "cancel-btn" %>
        </div>

    <% end %>
</div>