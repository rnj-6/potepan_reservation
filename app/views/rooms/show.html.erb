<%# 白いカード %>
<div class="room-show-card">
    <div>
        <%= link_to "◂ 戻る", request.referer || root_path, class: "back-btn" %>
        <% if @room.user == current_user %>
           <%= link_to "編集", edit_room_path, class: "edit-btn" %>
        <% end %>
    </div>

    <div class="room-show-content">
        <div>
            <% if @room.image.attached? %>
               <%= image_tag @room.image.variant(resize_to_fill: [450, 300]) %>
            <% else %>
               <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", width: 450, height: 300 %>
            <% end %>
        </div>

        <%# 青いカード %>
        <div class="room-show-info">

            <%# 名前と料金 %>
            <div class="room-show-content-title">
                <p class="room-show-name"><%= @room.name %></p>
                <p class:="room-show-price">￥<%= @room.price %> ～</p>
            </div>

            <p class="room-show-address"><%= @room.address %></p>
            <p class="room-show-description"><%= @room.description %></p>

            <%# 予約に必要な情報（チェックイン/チェックアウト/人数） %>
            <div>
            </div>

            <%# 予約ボタンのパスは後で追加 %>
            <%= link_to "予約する" %>
        </div>
    </div>
</div>