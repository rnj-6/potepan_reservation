<%# 白いカード %>
<div class="room-show-container">
    <div class="room-show-btn-menu">
        <%= link_to "◂ 戻る", request.referer || root_path, class: "back-btn" %>
        <% if @room.user == current_user %>
            <%= link_to "編集", edit_room_path, class: "edit-btn" %>
        <% end %>
    </div>
    
    <div class="room-show-content">
        <div>
            <% if @room.image.attached? %>
               <%= image_tag @room.image.variant(resize_to_fill: [450, 300]) %>
            <% else %>
               <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", width: 450, height: 300 %>
            <% end %>
        </div>

        <%# 黄色のカード %>
        <div class="room-show-info">

            
            <%# 名前と料金 %>
            <div class="room-show-content-title">
                <p class="room-show-name"><%= @room.name %></p>
                <p class="room-show-price">￥<%= @room.price %>~</p>
            </div>

            <p class="room-show-address">📍<%= @room.address %></p>
            <p class="room-show-description"><%= @room.description %></p>

            <%= form_with model: @reservation, url: confirm_room_reservations_path(@room), method: :post, data: { turbo: false } do |f| %>

                <%# 予約に必要な情報（チェックイン/チェックアウト/人数） %>
                <div class="reserv-form-container">
                    <div class="date-firld">
                        <%= f.label :checkin_at, "チェックイン" %>
                        <%= f.date_field :checkin_at %>
                    </div>

                    <div class="date-firld">
                        <%= f.label :checkout_at, "チェックアウト" %>
                        <%= f.date_field :checkout_at %>
                    </div>

                    <div class="guest-count-field">
                        <%= f.label :guest_count, "人数" %>

                        <div class="guest-input-wrapper">
                            <%= f.number_field :guest_count, placeholder: "0", class: "guest-input" %><span class="guest-unit">人</span>
                        </div>
                    </div>

                </div>

                <div class="room-show-btn-menu">
                    <% if user_signed_in? %>
                        <%= f.submit "予約する", class: "room-show-reserv-btn" %>
                    <% else %>
                        <%= link_to "ログイン", new_user_session_path, class: "room-show-login-btn" %>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>