<div class="room-index-card">
    <h2>作成した施設一覧</h2>

    <table class="room-index-table">
        <tr>
            <th>写真</th>
            <th>施設名</th>
            <th>施設詳細</th>
            <th>料金</th>
            <th>作成日</th>
            <th></th>
            <th></th>
        </tr>

        <% @rooms.each do |room| %>
            <tr>
                <td class="index-room-image">
                    <%= link_to room_path(room) do %>
                        <% if room.image.attached? %>
                            <%= image_tag room.image.variant(resize_to_fill: [100, 67]) %>
                        <% else %>
                            <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", width: 100, height: 67 %>
                        <% end %>
                    <% end %>
                </td>

                <td class="index-room-name">
                    <%= link_to room_path(room) do %>
                        <%= room.name %>
                    <% end %>
                </td>

                <td class="index-description">
                    <div class="description-text">
                        <%= room.description %>
                    </div>
                </td>
                <td>￥<%= room.price %>~</td>
                <td><%= room.updated_at.strftime("%Y/%m/%d") %></td>
                <td><%= link_to "編集", edit_room_path(room), class: "room-index-link" %></td>
                <td><%= link_to "削除", room, data: { turbo_method: :delete, turbo_confirm: "【 #{room.name} 】 を削除しますか？" }, class: "room-index-link" %></td>
            </tr>
        <% end %>
    </table>

</div>