<div>
    <h2>予約一覧</h2>

    <table class="reserv-index-table">
        <tr>
            <th>写真</th>
            <th>施設名</th>
            <th>施設詳細</th>
            <th>支払い料金</th>
            <th>チェックイン日</th>
            <th>チェックアウト日</th>
            <th>予約確定日時</th>
        </tr>

        <% @reservations.each do |reservation| %>
            <tr>
                <td>
                    <%= link_to room_path(reservation.room) do %>
                        <% if reservation.room.image.attached? %>
                            <%= image_tag room.image.variant(resize_to_fill: [100, 67]) %>
                        <% else %>
                            <%= image_tag "https://rails-02-sample.herokuapp.com/assets/room/default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d.png", width: 100, height: 67 %>
                        <% end %>
                    <% end %>
                </td>

                <td>
                    <%= link_to room_path(reservation.room) do %>
                        <%= reservation.room.name %>
                    <% end %>
                </td>

                <td><%=  reservation.room.description %></td>
                <td>￥<%= reservation.total_price %>~</td>
                <td><%= reservation.checkin_at %></td>
                <td><%= reservation.checkout_at %></td>
                <td><%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></td>
            </tr>
        <% end %>
    </table>

</div>